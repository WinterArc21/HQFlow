{
  "name": "hqflow",
  "version": "0.4.0",
  "type": "module",
  "description": "Local-first workflow mapping for coding agents, rendered as an interactive canvas.",
  "license": "MIT",
  "author": "WinterArc21",
  "homepage": "https://github.com/WinterArc21/HQFlow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinterArc21/HQFlow.git"
  },
  "bugs": {
    "url": "https://github.com/WinterArc21/HQFlow/issues"
  },
  "keywords": [
    "hqflow",
    "hq-flow",
    "workflow",
    "architecture",
    "devtools",
    "visualization",
    "canvas",
    "codebase",
    "documentation",
    "coding-agent",
    "local-first",
    "coding-agents",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.3",
  "bin": {
    "hqflow": "dist/node/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "pnpm run build:export && npm-run-all2 --parallel dev:web dev:server",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/dev.ts",
    "build": "pnpm run build:node && pnpm run build:web && pnpm run build:export",
    "prepublishOnly": "pnpm run build",
    "build:node": "tsup",
    "build:web": "vite build",
    "build:export": "vite build --config vite.export.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "pnpm run build:export",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
